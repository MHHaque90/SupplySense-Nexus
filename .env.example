# SupplySense Nexus - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=SupplySense Nexus
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-value

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplysense
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/supplysense_test

# Server
HOST=0.0.0.0
PORT=8000

# AI Assistant (replace with your provider)
OPENAI_API_KEY=your-openai-api-key-here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_AI_ASSISTANT=false
ENABLE_OPTIMIZATION=false
ENABLE_SIMULATION=false

# Data
DATA_SOURCE_PATH=data/
SYNTHETIC_DATA_SEED=42

# CORS (for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
