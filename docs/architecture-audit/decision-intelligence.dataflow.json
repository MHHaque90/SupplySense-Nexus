    {
      "dot": "cyan",
      "title": "What reaches replay",
      "items": [
        "replay imports ForecastInput and the public simulation API only (replay/replay.py:36,50)",
        "simulation contributes baseline, comparison, monte_carlo, runner and traceability modules",
        "one shared baseline plus common random numbers feed every decision arm"
      ]
    },
    {
      "dot": "rose",
      "title": "What stops at CLI reports",
      "items": [
        "no analytics.risk or analytics.procurement import exists anywhere under analytics/replay/",
        "procurement and risk feed reports only — no decision-analysis consumer exists yet",
        "Phase 9 never ranks, recommends or optimizes (replay/__init__.py:1-13)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Handoff contracts",
      "items": [
        "ForecastInput carries point / lower / upper plus model metadata (inventory/types.py:100)",
        "SimulationScenario freezes event, horizon, seed and simulation_count (simulation/types.py:142)",
        "every emitted report carries data_source_label = simulated"
      ]
    }
