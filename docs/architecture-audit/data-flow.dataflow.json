  "cards": [
    {
      "dot": "cyan",
      "title": "Write path",
      "items": [
        "generate_dataset() is pure and in-memory; load_dataset() inserts 20 tables (data/ingestion/pipeline.py:115,217)",
        "11 quality check groups persist to data_quality_checks (data/quality/checks.py:403)",
        "Every generated row carries data_source_label = synthetic"
      ]
    },
    {
      "dot": "emerald",
      "title": "Read and forecast handoff",
      "items": [
        "Dataset loaders run AsyncSession ORM selects; no raw SQL in application code",
        "forecasts / forecast_runs / model_versions are written by forecasting/persistence.py:119",
        "inventory/forecast_inputs.py:27 reloads them as ForecastInput for downstream stages"
      ]
    },
    {
      "dot": "rose",
      "title": "Decision layers",
      "items": [
        "procurement consumes inventory results; risk consumes both (procurement/reports.py:14, risk/reports.py:15)",
        "simulation builds one shared baseline per scenario (simulation/baseline.py:13)",
        "replay imports only inventory and simulation (replay/replay.py:36,50)"
      ]
    }
  ]
